# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Neon Database URL
DATABASE_URL="postgres://user:password@ep-rest-of-url.us-east-2.aws.neon.tech/neondb"

# Resend API Key for sending emails and receiving webhooks
RESEND_API_KEY="re_123456789"

# Auth Secret for NextAuth
AUTH_SECRET="my_super_secret_auth_key"

# OpenAI Compatible API (Optional)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# The email address authorized to use the app
AUTHORIZED_EMAIL="mother@example.com"
